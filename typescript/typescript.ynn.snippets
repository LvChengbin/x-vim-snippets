# Ynn Initialize
snippet ;;y.i "const Ynn = require( 'ynn' ); ... module.exports = app;"
const Ynn = require( 'ynn' );

const app = new Ynn( {
	root : __dirname,
	debugging : ${1:false},
	logging : ${2:true}${0:${VISUAL}}
} );

module.parent || app.listen( Ynn.cargs.port );
module.exports = app;
endsnippet

